{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MichiClaude",
  "version": "0.2.0",
  "identifier": "com.oscarorozco.michiclaude",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "cargo build --release --manifest-path relevo/Cargo.toml || cargo build --release --manifest-path ../relevo/Cargo.toml",
    "beforeDevCommand": "cargo build --release --manifest-path relevo/Cargo.toml || cargo build --release --manifest-path ../relevo/Cargo.toml"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MichiClaude",
        "width": 446,
        "height": 660,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "notif",
        "title": "MichiClaude — notif",
        "url": "notif.html",
        "width": 252,
        "height": 128,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../relevo/target/release/michi.exe": "michi.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Spanish",
          "SpanishInternational",
          "PortugueseBR",
          "French",
          "German",
          "Japanese",
          "Korean",
          "SimpChinese"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/oscarorozcos/michiclaude/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzMzNFRTI4NDg3OTdCNDMKUldSRGUzbElLTzR6dytURzdmT3Y4OHh2aEFPcml5cXl0WWNJaXNNNWZiSkFpUU85VmJEZ05CczkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
